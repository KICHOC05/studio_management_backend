# Copy this file to .env.local and fill in DB_PASSWORD.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studio_management
DB_USERNAME=studio_app
DB_PASSWORD=
DB_SSL_MODE=PREFERRED

# Required: generate a random Base64 secret with at least 32 bytes.
JWT_SECRET=
JWT_ISSUER=studio-management-backend
JWT_ACCESS_TOKEN_MINUTES=15

# Enable for the first startup, then disable and remove the password.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
